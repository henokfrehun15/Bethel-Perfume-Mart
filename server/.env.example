# Server environment variables (copy to .env and fill in)

# Runtime
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/bethel_perfume
# Set to 0 for a local PostgreSQL server that does not use SSL
# (managed providers such as Neon/Supabase require 1 - the default).
DATABASE_SSL=1

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Server
PORT=5000
# Allowed browser origin for CORS
CLIENT_URL=http://localhost:3000
# Set to 1 only when the API runs behind a reverse proxy (Render, Nginx, ...)
# so rate limiting and logs see the real client IP.
TRUST_PROXY=0

# WhatsApp notifications (optional — preferred source is the
# whatsapp_number key in store settings, editable in the admin panel)
# WHATSAPP_NUMBER=+2519XXXXXXXX

# Optional: webhook that receives new-order WhatsApp payloads
# (e.g. a WhatsApp Cloud API / CallMeBot / n8n bridge).
# When set, the server POSTs the formatted message to this URL.
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

