# Server environment variables (copy to .env and fill in)

# Runtime
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/bethel_perfume
# Set to 0 for a local PostgreSQL server that does not use SSL
# (managed providers such as Neon/Supabase require 1 - the default).
DATABASE_SSL=1
# Keep-alive ping interval in milliseconds (default 4 minutes).
# Neon and other serverless providers suspend idle computes and drop
# idle connections after ~5 minutes, making the next request pay a
# multi-second (or worse) cold start. The server pings the database
# to keep it warm; set to 0 to disable (e.g. to preserve compute
# hours on Neon's free plan).
DB_KEEP_ALIVE_MS=240000

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# SameSite attribute of the admin session cookie. The default "lax"
# works when the API and the admin app share a registrable domain;
# set to "none" when they are served from different production
# domains (the cookie is then https-only).
COOKIE_SAME_SITE=lax

# Server
PORT=5000
# Allowed browser origin for CORS
CLIENT_URL=http://localhost:3000
# Set to 1 only when the API runs behind a reverse proxy (Render, Nginx, ...)
# so rate limiting and logs see the real client IP.
TRUST_PROXY=0

# Rate limiter counters are kept in memory by default. Set this to a
# Redis connection string to share counters between API instances
# (required when scaling horizontally; the limiter fails open if
# Redis becomes unreachable).
# REDIS_URL=redis://localhost:6379

# WhatsApp notifications (optional — preferred source is the
# whatsapp_number key in store settings, editable in the admin panel)
# WHATSAPP_NUMBER=+2519XXXXXXXX

# Optional: webhook that receives new-order WhatsApp payloads
# (e.g. a WhatsApp Cloud API / CallMeBot / n8n bridge).
# When set, the server POSTs the formatted message to this URL.
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# Product image uploads
# Directory that receives uploaded images (relative to the server
# folder). Only used by the "local" storage driver.
UPLOAD_DIR=uploads
# Maximum upload size in bytes (default 5 MB)
UPLOAD_MAX_BYTES=5000000
# Absolute base URL for uploaded images. Leave empty to store upload
# URLs as /uploads/... paths that clients resolve against the API
# origin (recommended — URLs then survive origin changes). Set this
# only when uploads are served from a separate asset host or CDN.
# PUBLIC_ASSET_URL=https://cdn.example.com

# Image storage backend: "local" (disk, default) or "s3" for S3 and
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...).
# Use "s3" in production: disk uploads are lost on redeploy and are
# not shared between instances.
# STORAGE_DRIVER=s3
# Required when STORAGE_DRIVER=s3:
# S3_BUCKET=bethel-uploads
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Custom endpoint for S3-compatible providers (leave empty for AWS):
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Public base for image URLs when served through a CDN (defaults to
# the bucket endpoint URL):
# S3_PUBLIC_URL=https://cdn.example.com

